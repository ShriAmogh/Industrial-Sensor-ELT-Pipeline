# =============================================================================
# Industrial Sensor ELT Pipeline - Environment Configuration Template
# Copy this file to .env and configure local/container credentials.
# =============================================================================

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Target Data Warehouse (PostgreSQL) Configuration
DW_POSTGRES_DB=sensor_dw
DW_POSTGRES_USER=dw_admin
DW_POSTGRES_PASSWORD=dw_password123
DW_POSTGRES_HOST=pipeline-db
DW_POSTGRES_PORT=5432
DW_HOST_PORT=5433

# Airflow Internal Metadata Database Configuration
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
